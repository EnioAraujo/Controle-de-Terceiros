# ─────────────────────────────────────────────────────────────────────────────
# Controle de Terceiros — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Project Settings → API

# URL do projeto Supabase (ex: https://xyzxyzxyz.supabase.co)
VITE_SUPABASE_URL=

# Chave anon pública do Supabase (segura para expor no frontend)
VITE_SUPABASE_ANON_KEY=

# ── Servidor — Vercel only ────────────────────────────────────────────────────
# ⚠️  Esta variável NÃO deve ser colocada aqui em produção.
#     Configure-a SOMENTE no dashboard da Vercel:
#     Project → Settings → Environment Variables → SUPABASE_SERVICE_ROLE_KEY
#
# Usada pela Vercel Serverless Function (api/admin-users.ts) para operações
# administrativas que requerem permissão de service_role (bypass de RLS).
# NUNCA exponha esta chave no frontend ou no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# ── Edge Function: admin-users ───────────────────────────────────────────────
# Domínio permitido para CORS (ex: https://controle-de-terceiros.vercel.app)
# Em produção, isso restringe quais origens podem chamar a Edge Function.
# Deixe vazio ou comente para desenvolvimento local (aceita qualquer origem).
ALLOWED_ORIGIN=
